# Copy to .env and fill in. Never commit real values.
# Local development values below match docker-compose.yml.

# Database (the roles app_user and app_system are created by `pnpm db:migrate`)
DATABASE_URL=postgres://app_user:app_user@localhost:5432/fregues
DATABASE_URL_SYSTEM=postgres://app_system:app_system@localhost:5432/fregues
# Owner of the tables. Only `pnpm db:migrate` and `pnpm db:codegen` use it.
DATABASE_URL_MIGRATE=postgres://postgres:postgres@localhost:5432/fregues

# Auth and signing
JWT_SECRET=
COOKIE_SECRET=
QR_TOKEN_SECRET=

# Key of the hash of the SMS codes (16 characters or more). Optional in development.
OTP_HASH_SECRET=
# How many proxies sit in front of the API (the limit per IP needs the real address).
TRUST_PROXY_HOPS=0

# URLs
APP_URL=http://localhost:5173
API_URL=http://localhost:3000

# SMS
# How the code is sent. Only "console" exists: it prints the code in the terminal of the API
# and runs only with NODE_ENV=development (decision D-022). Never set it in production.
SMS_PROVIDER=console
SMS_API_KEY=

# E-mail
EMAIL_FROM=
EMAIL_API_KEY=

# Billing (Mercado Pago)
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# Monitoring
SENTRY_DSN=
