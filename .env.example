# Copy to .env and fill in. Never commit real values.
# Local development values below match docker-compose.yml.

# Database (roles app_user and app_system are created in milestone M0)
DATABASE_URL=
DATABASE_URL_SYSTEM=

# Auth and signing
JWT_SECRET=
COOKIE_SECRET=
QR_TOKEN_SECRET=

# URLs
APP_URL=http://localhost:5173
API_URL=http://localhost:3000

# SMS
SMS_PROVIDER=
SMS_API_KEY=

# E-mail
EMAIL_FROM=
EMAIL_API_KEY=

# Billing (Mercado Pago)
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# Monitoring
SENTRY_DSN=
